# Build directories
build/
cmake-build-*/
Build/
Builds/

# Generated files
*.user
*.autosave
*.swp
*~
{% if cookiecutter.include_faust == "yes" -%}
*.dsp.json
{% endif %}
# CMake
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps
{% if cookiecutter.include_daisy == "yes" and cookiecutter.include_faust == "yes" -%}
# The bare "Makefile" rule above is for CMake's generated build-dir Makefiles;
# daisy/Makefile is a real, checked-in project file.
!daisy/Makefile

# Daisy codegen output is sized for the embedded target's fixed sample rate
# (see daisy/README.md) -- never mix it with the desktop's src/dsp/generated/.
daisy/generated/
daisy/build/
{% endif %}

# IDE
.vscode/**/*
!.vscode/c_cpp_properties.json
.idea/
*.code-workspace
.DS_Store

# Compiled binaries
*.exe
*.dll
*.so
*.dylib
*.app
*.vst
*.vst3
*.component
*.aaxplugin

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Local scripts config
scripts/element_project.conf
